SECURITY_API_HOST=0.0.0.0
SECURITY_API_PORT=8001

# Local-first: quarantine classifier runs on Ollama (OpenAI-compatible API).
# Point the endpoint at the host/container Ollama; clear it for a hosted provider.
SECURITY_SANITIZE_MODEL=openai:qwen2.5:3b-8k
SECURITY_SANITIZE_ENDPOINT=http://localhost:11434/v1
OPENAI_API_KEY=ollama-local
SECURITY_SANITIZE_ALWAYS_LLM=false
SECURITY_SANITIZE_MAX_CHARS=6000
SECURITY_SANITIZE_TIMEOUT=

SECURITY_POLICY_PATH=policy.yaml


# Phase 4 shared platform state (optional; defaults keep in-memory dev mode)
DATABASE_URL=
REDIS_URL=
SECURITY_RATELIMIT_BACKEND=memory  # memory | redis
TENANT_MODE=single

# Optional manager-injected secret bundles (incremental vault/KMS rollout)
SECURITY_SECRET_MANAGER_BACKEND=disabled   # disabled | bundle | vault
SECURITY_SECRET_MANAGER_REQUIRED=false
SECURITY_SECRET_BUNDLE_PATH=
SECURITY_SECRET_MANAGER_URL=
SECURITY_SECRET_MANAGER_PATH=
SECURITY_SECRET_MANAGER_TOKEN_FILE=
