# LLM providers — fill in one or both
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth (download from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Agent behaviour
DEFAULT_LLM_PROVIDER=openai       # openai | anthropic
AGENT_MAX_EMAILS_PER_RUN=20
AGENT_DRY_RUN=true                # true = read-only, never sends

# API server
API_HOST=0.0.0.0
API_PORT=8000
