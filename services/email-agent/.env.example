# LLM backend — local-first. The default `local` profile talks to Ollama on the
# host; no cloud key is required. OPENAI_API_KEY just needs to be non-empty for
# the OpenAI-compatible client (Ollama ignores it).
OPENAI_API_KEY=ollama-local
# Cloud providers (optional — only for the explicit dev/prod profiles)
# GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth (download from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Agent behaviour
AGENT_LLM_PROFILE=local            # selects config/llm.<profile>.yaml (local=ollama on the laptop [default], local-host/local-docker=ollama from containers, safe=local low-cap, dev=groq, prod=LiteLLM)
# local profile talks to Ollama at http://localhost:11434/v1 (openai-compatible); run `ollama pull qwen2.5:3b`
AGENT_LLM_CONFIG_PATH=             # optional explicit override for the LLM profile file
AGENT_LLM_STREAMING_ENABLED=true   # stream draft content over SSE when the UI opts into the streaming endpoint
AGENT_ROLES_PATH=roles.yaml        # owner-editable role directory seed (dev/local file backend)
AGENT_CONTACTS_PATH=contacts.yaml  # owner-editable contact/segment store seed (dev/local file backend)
AGENT_MAX_EMAILS_PER_RUN=20
AGENT_POLL_INTERVAL_MIN=5          # inbox poll cadence for `python -m src.poller`
AGENT_POLL_MAX_RETRIES=3          # retries per email for transient upstream failures
AGENT_POLL_BACKOFF_BASE_SECONDS=2 # exponential backoff base between retries
AGENT_NOTIFY_ENABLED=false         # email the responsible approver when a run pauses for approval
AGENT_NOTIFY_APP_BASE_URL=         # optional web control panel URL; used for the link-back in notifications
AGENT_DRY_RUN=true                # set false only after HITL gate is confirmed
AGENT_EXTRACT_ATTACHMENTS=false    # set true to download and extract PDF text into context
AGENT_ATTACHMENT_MAX_CHARS=3000   # cap on extracted text per PDF

# Security service (off by default; set AGENT_SECURITY_ENABLED=true to vet inbound mail)
AGENT_SECURITY_ENABLED=false
AGENT_SECURITY_URL=http://localhost:8001
AGENT_SECURITY_TIMEOUT=10

# Domains treated as "internal" for a category's external_send_allowed=false guard
# (comma-separated, e.g. company.com,eu.company.com). Independent of the security
# service above — a local workflow-policy rule, not a security-vetting one.
AGENT_INTERNAL_DOMAINS=

# LangGraph Studio (optional — enables run tracing)
# LANGSMITH_API_KEY=lsv2_...

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Phase 4 platform mode (optional; defaults keep single-user SQLite dev mode)
DATABASE_URL=
AGENT_MIGRATION_DATABASE_URL=    # owner URL used only by the migration process
AGENT_RUN_MIGRATIONS=true       # false for restricted API/poller runtime processes
AGENT_BACKUP_DIR=backups       # pg_dump output dir for scripts/backup.sh
REDIS_URL=
AGENT_STORAGE_BACKEND=sqlite      # sqlite | postgres
AGENT_RUN_REGISTRY_BACKEND=json    # json | postgres
TENANT_MODE=single                # single | multi
AGENT_DEFAULT_USER_ID=default
# Map an external identity (Gmail address) to the platform user id the gateway sends
# via X-Agora-User, so webhook-driven and API-driven runs share one tenant key.
# JSON object, e.g. {"alice@gmail.com": "alice"}. Empty = identity mapping.
AGENT_USER_MAP=
GMAIL_WEBHOOK_ENABLED=false
GMAIL_WEBHOOK_TOPIC=            # projects/<gcp-project>/topics/<topic> (see docs/gmail-push-setup.md)
GMAIL_WEBHOOK_SECRET=
# Poll cadence when webhooks are ON (polling becomes a slow safety net).
AGENT_WEBHOOK_FALLBACK_POLL_MIN=10
# Per-user last-processed Gmail historyId baseline (incremental push sync).
GMAIL_SYNC_PATH=logs/gmail_sync.json
# Gmail watches expire after 7 days; the poller re-registers on this cadence.
GMAIL_WATCH_RENEW_HOURS=24
# Renew a watch once its recorded expiration is closer than this margin (hours).
GMAIL_WATCH_RENEW_MARGIN_HOURS=12
GMAIL_POLLING_FALLBACK_ENABLED=true
GMAIL_TOKEN_STORE_PATH=logs/gmail_tokens.json
# Uploaded media (signature images, contact photos). Compose sets /app/data/media.
AGENT_MEDIA_DIR=logs/instances
AGENT_MEDIA_BACKEND=local     # local (dev/single-VPS) | s3 (OVH Object Storage / any S3-compatible bucket)
AGENT_MEDIA_S3_BUCKET=
AGENT_MEDIA_S3_ENDPOINT_URL=
AGENT_MEDIA_S3_REGION=
# Soft per-instance hourly Gmail API call budget (health display + 80% alert).
GMAIL_HOURLY_CALL_BUDGET=1000
# Browser OAuth redirect registered in Google Cloud Console.
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/api/agent/connect/gmail/callback
# Required to sign CSRF state for browser Gmail OAuth. Can differ from token encryption.
# Also signs the Outlook OAuth state — the secret protects the state envelope, not the account.
GMAIL_OAUTH_STATE_SECRET=change-me

# --- Outlook / Microsoft Graph (optional) ---
# Only needed for instances whose mail provider is set to "outlook". Gmail-only
# deployments can leave all four blank. Values come from an Azure app
# registration with delegated Mail.ReadWrite + Mail.Send + User.Read.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# "common" accepts work/school and personal accounts; use a directory id to pin single-tenant.
OUTLOOK_TENANT=common
# Must be listed as a redirect URI in the Azure app registration.
OUTLOOK_OAUTH_REDIRECT_URI=http://localhost:8080/api/agent/connect/outlook/callback
# Prod: point to a mounted secret file. The file may contain a raw secret string or
# JSON like {"active_key_id":"2026-07","keys":{"2026-06":"old","2026-07":"new"}}.
# Stored token envelopes derive a separate wrapping key per agent instance.
AGENT_TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/agora_token_keys
# Back-compat only for local dev. Do not use plaintext env secrets in prod.
AGENT_TOKEN_ENCRYPTION_KEY=
AGENT_TOKEN_ENCRYPTION_REQUIRED=false
AGENT_TOKEN_STORE_BACKEND=file          # file (dev) | vault (production)
AGENT_TOKEN_WORK_DIR=/tmp/agora-token-work
AGENT_TOKEN_VAULT_PATH=secret/data/agora/gmail-tokens


# Optional manager-injected secret bundles (incremental vault/KMS rollout)
AGENT_SECRET_MANAGER_BACKEND=disabled   # disabled | bundle | vault
AGENT_SECRET_MANAGER_REQUIRED=false
AGENT_SECRET_BUNDLE_PATH=
AGENT_SECRET_MANAGER_URL=
AGENT_SECRET_MANAGER_PATH=
AGENT_SECRET_MANAGER_TOKEN_FILE=
AGENT_DLQ_BACKEND=json                  # json | postgres | redis
AGENT_DLQ_PATH=logs/dlq.json
