# Local-first: agents and the security classifier run on Ollama by default.
# Non-empty placeholder for the OpenAI-compatible client (Ollama ignores it).
OPENAI_API_KEY=ollama-local
# Production TLS ingress (the production profile publishes only TCP 443).
AGORA_TLS_CERT_FILE=./traefik/certs/tls.crt
AGORA_TLS_KEY_FILE=./traefik/certs/tls.key
AGENT_TOKEN_KEYS_FILE=./secrets/agent-token-keys
AGENT_VAULT_TOKEN_FILE=./secrets/agent-vault-token
# Match the owner of the certificate files (run `id -u` and `id -g`).
TRAEFIK_UID=1000
TRAEFIK_GID=1000
GMAIL_OAUTH_REDIRECT_URI=https://mail.example.com/api/agent/connect/gmail/callback
GATEWAY_CORS_ALLOWED_ORIGINS=https://mail.example.com
GATEWAY_LOGIN_RATELIMIT_ENABLED=true
GATEWAY_LOGIN_RATELIMIT_WINDOW_SECONDS=900
GATEWAY_LOGIN_RATELIMIT_MAX_FAILURES=5
GATEWAY_LOGIN_RATELIMIT_GLOBAL_MAX_FAILURES=100

# Cloud providers — only for the optional `cloud` compose profile / prod LLM profile.
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
GATEWAY_JWT_SECRET=
GATEWAY_JWT_TTL_MINUTES=15
GATEWAY_JWT_REFRESH_TTL_DAYS=7
GATEWAY_JWT_SECURE_COOKIES=true
# TOTP second factor, opt-in per user via /auth/mfa/setup + /auth/mfa/confirm.
GATEWAY_MFA_CHALLENGE_TTL_MINUTES=5
GATEWAY_MFA_RECOVERY_CODE_COUNT=8
GATEWAY_OWNER_USERNAME=
GATEWAY_OWNER_PASSWORD=
GATEWAY_VIEWER_USERNAME=
GATEWAY_VIEWER_PASSWORD=
GATEWAY_ADMIN_USERNAME=
GATEWAY_ADMIN_PASSWORD=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
AGENT_POSTGRES_PASSWORD=

# Host-side Postgres backup / restore drill
AGORA_BACKUP_DIR=./backups/postgres
AGORA_BACKUP_RETENTION_DAYS=14
# Restore is destructive and requires AGORA_RESTORE_CONFIRM=restore-${target_db}.
# Use AGORA_RESTORE_DB=agora_restore_drill with create enabled for a disposable drill.
AGORA_RESTORE_DB=
AGORA_RESTORE_CREATE_DB=false
AGORA_RESTORE_CONFIRM=

# System mail sent by the agent itself: "an approval is waiting", "this approval
# is past its SLA", and technical alerts (a component down, the daily token cap).
# All three go out through the connected mailbox, so they stay off by default.
# AGENT_NOTIFY_APP_BASE_URL is the web app URL used to link back to the approval —
# a notification never carries the original email body.
AGENT_NOTIFY_ENABLED=false
AGENT_NOTIFY_APP_BASE_URL=
# Applies to any instance that has not saved its own alert settings.
AGENT_ALERTS_ENABLED=false
AGENT_ALERT_ADMIN_RECIPIENT=

# Phase 4 platform mode
DATABASE_URL=postgresql://agora:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-agora}
REDIS_URL=redis://redis:6379/0
TENANT_MODE=single
AGENT_STORAGE_BACKEND=postgres
AGENT_RUN_REGISTRY_BACKEND=postgres
AGENT_DEFAULT_USER_ID=default
# JSON map of Gmail address -> platform user id (align with gateway X-Agora-User in multi mode).
AGENT_USER_MAP=
GMAIL_WEBHOOK_ENABLED=false
GMAIL_WEBHOOK_TOPIC=            # projects/<gcp-project>/topics/<topic> (services/email-agent/docs/gmail-push-setup.md)
GMAIL_WEBHOOK_SECRET=
AGENT_WEBHOOK_FALLBACK_POLL_MIN=10
GMAIL_WATCH_RENEW_HOURS=24
GMAIL_WATCH_RENEW_MARGIN_HOURS=12
GMAIL_POLLING_FALLBACK_ENABLED=true
# Set a passphrase to encrypt OAuth tokens at rest (Fernet).
AGENT_TOKEN_ENCRYPTION_KEY=
AGENT_TOKEN_ENCRYPTION_KEY_FILE=
AGENT_TOKEN_ENCRYPTION_REQUIRED=false
AGENT_TOKEN_STORE_BACKEND=file
AGENT_TOKEN_WORK_DIR=/tmp/agora-token-work
AGENT_TOKEN_VAULT_PATH=secret/data/agora/gmail-tokens
# Signs the Gmail OAuth state param (CSRF + tenant/instance binding). Falls back to the token key.
GMAIL_OAUTH_STATE_SECRET=

# --- Outlook / Microsoft Graph (optional) ---
# Only needed for instances whose mail provider is "outlook". Leave blank for
# Gmail-only deployments. From an Azure app registration with delegated
# Mail.ReadWrite + Mail.Send + User.Read.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=common
OUTLOOK_OAUTH_REDIRECT_URI=https://mail.example.com/api/agent/connect/outlook/callback

# --- Seeded default instance ---
# Mailbox the seeded email-agent instance expects the Gmail OAuth flow to
# authorize. Leave blank unless you want the default instance pinned to one
# address: a non-blank value is compared against the mailbox Google reports and
# fails closed on a mismatch, so a wrong or placeholder value makes the instance
# impossible to connect.
GATEWAY_DEFAULT_AGENT_MAILBOX=

# --- Invitation e-mail (optional) ---
# Without a relay the invitation endpoints still succeed and return the setup
# link for an admin to deliver by hand.
GATEWAY_APP_URL=https://mail.example.com
GATEWAY_INVITE_EXPIRY_HOURS=48
GATEWAY_SMTP_HOST=
GATEWAY_SMTP_PORT=587
GATEWAY_SMTP_USERNAME=
GATEWAY_SMTP_PASSWORD=
GATEWAY_SMTP_FROM=
SECURITY_RATELIMIT_BACKEND=redis
# Instance onboarding pipeline (sync, style, contacts, categories, backlog).
AGENT_SETUP_PIPELINE_ENABLED=true
AGENT_SETUP_RECENT_LIMIT=50
AGENT_SETUP_BACKLOG_LIMIT=20
AGENT_SETUP_SENT_SAMPLE=20
AGENT_SETUP_STALE_SECONDS=300
AGENT_SETUP_MAX_ATTEMPTS=3
# In-app notification centre.
AGENT_NOTIFICATION_RETENTION_DAYS=90


# LLM gateway routing
AGENT_LLM_PROFILE=local
AGENT_LLM_PROMPT_CACHE_ENABLED=true


# Optional manager-injected secret bundles (incremental vault/KMS rollout)
AGENT_SECRET_MANAGER_BACKEND=disabled   # disabled | bundle | vault
AGENT_SECRET_MANAGER_REQUIRED=false      # set true in prod to disable plaintext env fallback
AGENT_SECRET_BUNDLE_PATH=
AGENT_SECRET_MANAGER_URL=
AGENT_SECRET_MANAGER_PATH=
AGENT_SECRET_MANAGER_TOKEN_FILE=
SECURITY_SECRET_MANAGER_BACKEND=disabled
SECURITY_SECRET_MANAGER_REQUIRED=false
SECURITY_SECRET_BUNDLE_PATH=
SECURITY_SECRET_MANAGER_URL=
SECURITY_SECRET_MANAGER_PATH=
SECURITY_SECRET_MANAGER_TOKEN_FILE=
GATEWAY_SECRET_DIR=/run/secrets/agora-gateway/
AGENT_LLM_CONFIG_PATH=config/llm.local-docker.yaml

# --- Runtime toggles referenced by docker-compose.yml -----------------------
# Host port the web UI is published on. GATEWAY_APP_URL must agree with it, or
# invitation links point somewhere the recipient cannot reach.
WEB_PORT=5173

# true = the agent simulates every mailbox mutation instead of performing it.
# Keep this true until you have deliberately decided otherwise.
AGENT_DRY_RUN=true

# Quarantined classifier used by the security service.
SECURITY_SANITIZE_MODEL=openai:qwen2.5:3b-8k
SECURITY_SANITIZE_ENDPOINT=http://ollama:11434/v1

# Strip IBAN / card / NIR / phone / email from mail content before it can reach
# a hosted model. Leave enabled unless every model runs on this host.
SECURITY_REDACT_PII=true
# Unset = automatic: on for any non-local AGENT_LLM_PROFILE.
AGENT_REDACT_FOR_MODEL=

# Path to the Google OAuth client secrets file mounted into the agent.
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json

# Only set on a host with an NVIDIA GPU, and use the overlay too:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
